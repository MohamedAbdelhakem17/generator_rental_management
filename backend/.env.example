# Runtime
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/generator_rental_management

# Auth (generate long random strings for these; never commit real values)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# CORS - frontend origin allowed to call this API with credentials
CORS_ORIGIN=http://localhost:3000
